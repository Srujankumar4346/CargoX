# CargoX Driver Frontend Configuration
# Copy this file to .env.local for local development or set in deployment environment

# Backend API Base URL (Do not include trailing slash)
# Local: http://127.0.0.1:8000
# Production: https://cargox-1.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Clerk Authentication Publishable Key (Frontend Public Key)
# e.g. pk_test_... or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
